{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aigc-explanation-v1",
  "type": "object",
  "required": [
    "schema_version",
    "model",
    "image",
    "prediction",
    "attribution",
    "transforms"
  ],
  "properties": {
    "schema_version": {
      "const": "aigc-explanation-v1"
    },
    "prediction": {
      "type": "object",
      "required": [
        "probability_fake",
        "aigc_confidence",
        "raw_logit"
      ]
    },
    "attribution": {
      "type": "object",
      "required": [
        "method",
        "semantics",
        "patches"
      ]
    },
    "transforms": {
      "type": "array"
    }
  }
}
